{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:field-service-crm:wp108:artifact-manifest:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundleId", "classification", "artifacts"],
  "properties": {
    "schema": { "const": "wave-a-offline-artifact-manifest-v1" },
    "bundleId": { "type": "string", "minLength": 1 },
    "classification": { "const": "PROOF_ONLY_NOT_APPLICATION_DEPENDENCIES" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "source", "sha256", "size", "class", "license"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 1 },
          "class": { "enum": ["EXECUTABLE_CANDIDATE", "SOURCE_REVIEW_ONLY", "REJECTED"] },
          "license": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
